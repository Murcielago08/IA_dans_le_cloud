# Copier ce fichier en .env (jamais versionné) et l'adapter.
# Toutes les variables SUBTITLER_* du README peuvent être définies ici.

# Compte administrateur créé au premier démarrage (8 caractères minimum)
SUBTITLER_ADMIN_USERNAME=admin
SUBTITLER_ADMIN_PASSWORD=changez-moi

# Traitements simultanés (un exemplaire du modèle par worker, ~1,5 Go de GPU chacun)
SUBTITLER_WORKERS=2

# Modèle et langue par défaut
SUBTITLER_DEFAULT_MODEL=whisper-medium.en
SUBTITLER_DEFAULT_LANGUAGE=en
